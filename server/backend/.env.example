# Export these process environment variables before starting the backend.
# This adapter uses the configured upstream; never put model API keys here.
DASHBOARD_UPSTREAM_URL=http://127.0.0.1:8000/
DASHBOARD_UPSTREAM_TIMEOUT_SECONDS=10
# Seed allowlist: projectId:cubeId separated by semicolons; locally created projects persist too.
DASHBOARD_PROJECTS=issue3-project-a:issue3-project-a;issue3-project-b:issue3-project-b
# Bootstrap selection when no valid persisted project preference is present.
DASHBOARD_DEFAULT_PROJECT_ID=issue3-project-a
DASHBOARD_DATA_DIR=.data
# Required to read real gateway call logs; use the gateway's calls-*.jsonl directory.
DASHBOARD_AUDIT_GATEWAY_DIR=/absolute/path/to/gateway/audit
# Share this path with the gateway MEMOS_TENANTS_FILE (and its writable parent directory).
DASHBOARD_GATEWAY_KEYS_FILE=/absolute/path/to/mcp-gateway/tenants.conf

# Authentication is enabled by default; initialize a local administrator first.
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_SESSION_TTL_SECONDS=86400
# Optional semicolon-separated explicit origins, no trailing path/slash.
# DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:5276;http://127.0.0.1:5281

# Total deadline for genuine prompt generation/debug calls (seconds; >0 and <=180).
DASHBOARD_MODEL_TIMEOUT_SECONDS=120
