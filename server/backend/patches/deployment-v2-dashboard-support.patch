+from memos.api.cloud_store import JsonMetadataStore
+from memos.api.profile import PROFILE_INSTANCE_KIND, ProfileService
+
+
+def fixture(tmp_path):
+    svc = ProfileService(JsonMetadataStore(tmp_path))
+    template = svc.add_template(
+        user_name="a",
+        name="test",
+        metadata={"basic": {"user_name": {"value": None}, "城市": {"value": None}}},
+    )
+    instance = svc.bind(
+        user_name="a", bind_list=[{"user_id": "u", "profile_template_id": template["entity_id"]}]
+    )[0]
+    svc.edit(
+        user_name="a",
+        template_id=template["entity_id"],
+        user_id="u",
+        metadata={"basic.user_name": {"value": "original"}, "basic.城市": {"value": "杭州"}},
+    )
+    return svc, template["entity_id"], instance["id"]
+
+
+def test_delete_one_field_hides_all_views_and_restores_original_after_updates_and_restart(tmp_path):
+    from memos.api.memory_lifecycle import MemoryLifecycle
+
+    profile, template, instance = fixture(tmp_path)
+    lifecycle = MemoryLifecycle(profile.store, None, profile)
+    identifier = instance + "_basic.user_name"
+    result = lifecycle.transition(
+        cube="a",
+        memory_id=identifier,
+        target_status="deleted",
+        operation_id="delete",
+        kind="profile",
+    )
+    assert result["success"] is True and result["vector_state"] == "not_applicable"
+    assert profile.get_field_row(user_name="a", memory_id=identifier) is None
+    assert profile.list_field_rows(user_name="a")[1] == 1
+    assert len(profile.recall(user_name="a", user_id="u")) == 1
+    assert "basic.user_name" not in profile.query(user_name="a", user_id="u")[0]["metadata"]
+    profile.edit(
+        user_name="a",
+        template_id=template,
+        user_id="u",
+        metadata={"basic.user_name": {"value": "must-not-overwrite"}},
+    )
+
+    class LLM:
+        def generate(self, *args, **kwargs):
+            return '{"basic.user_name":"must-not-overwrite"}'
+
+    profile.extract_and_update(user_name="a", user_id="u", llm=LLM(), conversation="test")
+    profile.update_template(
+        user_name="a",
+        template_id=template,
+        metadata={"basic": {"user_name": {"value": "template-new"}, "城市": {"value": None}}},
+    )
+    raw = profile.store.get(PROFILE_INSTANCE_KIND, instance)
+    assert raw["fields"]["basic.user_name"]["status"] == "deleted"
+    assert raw["fields"]["basic.user_name"]["value"] == "original"
+    restarted = ProfileService(JsonMetadataStore(tmp_path))
+    assert restarted.get_field_row(user_name="a", memory_id=identifier) is None
+    restored = MemoryLifecycle(restarted.store, None, restarted).transition(
+        cube="a",
+        memory_id=identifier,
+        target_status="restore",
+        operation_id="restore",
+        kind="profile",
+    )
+    assert restored["success"] is True
+    assert (
+        restarted.get_field_row(user_name="a", memory_id=identifier)["memory"]
+        == "basic.user_name: original"
+    )
+    assert (
+        restarted.get_field_row(user_name="a", memory_id=instance + "_basic.城市")["memory"]
+        == "basic.城市: 杭州"
+    )
+
+
+def test_profile_transition_cross_tenant_rejected(tmp_path):
+    import pytest
+
+    from memos.api.memory_lifecycle import LifecycleError, MemoryLifecycle
+
+    profile, _, instance = fixture(tmp_path)
+    with pytest.raises(LifecycleError) as exc:
+        MemoryLifecycle(profile.store, None, profile).transition(
+            cube="b",
+            memory_id=instance + "_basic.user_name",
+            target_status="deleted",
+            operation_id="cross",
+            kind="profile",
+        )
+    assert exc.value.code == 404
