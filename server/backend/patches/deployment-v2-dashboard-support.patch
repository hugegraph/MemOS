@@ -0,0 +1,22 @@
+"""Read authoritative scoped lifecycle fields before lossy provider parsing."""
+
+from typing import Any
+
+
+def read_control_node(graph: Any, identifier: str, cube: str) -> dict | None:
+    driver = getattr(graph, "driver", None)
+    if driver is None:
+        return graph.get_node(identifier, user_name=cube)
+    with driver.session(database=graph.db_name) as session:
+        row = session.run(
+            "MATCH (n:Memory {id:$id, user_name:$cube}) "
+            "RETURN n.id AS id, n.user_name AS user_name, n.status AS status, "
+            "n.memory_type AS memory_type, n.vector_sync AS vector_sync, "
+            "n.previous_status AS previous_status",
+            id=identifier,
+            cube=cube,
+        ).single()
+        if row is None:
+            return None
+        values = dict(row)
+        return {"id": values.pop("id"), "metadata": values}
