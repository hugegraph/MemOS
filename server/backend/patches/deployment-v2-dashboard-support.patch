+import copy
+import threading
+
+from concurrent.futures import ThreadPoolExecutor
+from types import SimpleNamespace
+
+import pytest
+
+from memos.api.cloud_store import JsonMetadataStore
+
+
+class Graph:
+    def __init__(self):
+        self.rows = {
+            "m1": {
+                "id": "m1",
+                "memory": "test-only",
+                "metadata": {"user_name": "a", "status": "activated", "vector_sync": "success"},
+            }
+        }
+        self.vec_db = Vector()
+        self.crash = False
+        self.writes = 0
+
+    def get_node(self, identifier, **kwargs):
+        row = self.rows.get(identifier)
+        return (
+            copy.deepcopy(row)
+            if row and row["metadata"]["user_name"] == kwargs.get("user_name")
+            else None
+        )
+
+    def update_node(self, identifier, fields, **kwargs):
+        self.rows[identifier]["metadata"].update(fields)
+        self.writes += 1
+        if self.crash:
+            raise SystemExit("simulated process interruption after graph commit")
+
+
+class Vector:
+    def __init__(self):
+        self.payload = {"status": "activated", "user_name": "a"}
+        self.offline = False
+        self.ignore_write = False
+
+    def get_by_id(self, identifier):
+        if self.offline:
+            raise OSError("vector unavailable")
+        return (
+            SimpleNamespace(payload=copy.deepcopy(self.payload))
+            if self.payload is not None
+            else None
+        )
+
+    def update(self, identifier, data):
+        if self.offline:
+            raise OSError("vector unavailable")
+        if not self.ignore_write:
+            self.payload.update(data["payload"])
+
+
+def service(tmp_path, graph=None):
+    from memos.api.memory_lifecycle import MemoryLifecycle
+
+    return MemoryLifecycle(JsonMetadataStore(tmp_path), graph or Graph())
+
+
+def transition(svc, target="deleted", op="delete-1", cube="a", identifier="m1"):
+    return svc.transition(cube=cube, memory_id=identifier, target_status=target, operation_id=op)
+
+
+def test_delete_restore_confirm_both_and_replay_does_not_undo_later_restore(tmp_path):
+    svc = service(tmp_path)
+    result = transition(svc)
+    assert result["state"] == "confirmed" and result["success"] is True
+    assert (
+        svc.graph.rows["m1"]["metadata"]["status"]
+        == svc.graph.vec_db.payload["status"]
+        == "deleted"
+    )
+    restored = transition(svc, "restore", "restore-1")
+    assert restored["target_status"] == "activated" and restored["state"] == "confirmed"
+    assert transition(svc)["state"] == "confirmed"
+    assert svc.graph.rows["m1"]["metadata"]["status"] == "activated"
+
+
+@pytest.mark.parametrize("failure", ["offline", "ignore_write", "missing"])
+def test_vector_failure_never_succeeds_and_restart_reconciles(tmp_path, failure):
+    graph = Graph()
+    if failure == "missing":
+        graph.vec_db.payload = None
+    else:
+        setattr(graph.vec_db, failure, True)
+    svc = service(tmp_path, graph)
+    result = transition(svc)
+    assert result["state"] == "pending" and result["success"] is False
+    assert graph.rows["m1"]["metadata"]["status"] == "deleted"
+    graph.vec_db.offline = graph.vec_db.ignore_write = False
+    graph.vec_db.payload = {"status": "activated", "user_name": "a"}
+    restarted = service(tmp_path, graph)
+    assert restarted.reconcile() == 1
+    assert transition(restarted)["state"] == "confirmed"
+    assert graph.vec_db.payload["status"] == "deleted"
+
+
+def test_crash_after_graph_commit_is_recoverable_and_opposite_operation_drains_first(tmp_path):
+    graph = Graph()
+    graph.crash = True
+    svc = service(tmp_path, graph)
+    with pytest.raises(SystemExit):
+        transition(svc)
+    graph.crash = False
+    restarted = service(tmp_path, graph)
+    result = transition(restarted, "restore", "restore-after-crash")
+    assert result["state"] == "confirmed"
+    assert graph.rows["m1"]["metadata"]["status"] == graph.vec_db.payload["status"] == "activated"
+
+
+def test_no_graph_mutation_when_intent_cannot_be_persisted(tmp_path, monkeypatch):
+    svc = service(tmp_path)
+
+    def fail(*args):
+        raise OSError("metadata unavailable")
+
+    monkeypatch.setattr(svc.store, "put", fail)
+    with pytest.raises(OSError):
+        transition(svc)
+    assert svc.graph.writes == 0
+
+
+def test_scope_frozen_and_conflicting_operation_id(tmp_path):
+    from memos.api.memory_lifecycle import LifecycleError
+
+    svc = service(tmp_path)
+    with pytest.raises(LifecycleError) as error:
+        transition(svc, cube="b")
+    assert error.value.code == 404
+    svc.graph.rows["m1"]["metadata"]["status"] = "frozen"
+    with pytest.raises(LifecycleError) as error:
+        transition(svc)
+    assert error.value.code == 409
+    svc.graph.rows["m1"]["metadata"]["status"] = "activated"
+    transition(svc)
+    with pytest.raises(LifecycleError) as error:
+        transition(svc, "restore", "delete-1")
+    assert error.value.code == 409
+
+
+def test_opposite_transitions_serialize_across_service_instances(tmp_path):
+    graph = Graph()
+    first, second = service(tmp_path, graph), service(tmp_path, graph)
+    began, release = threading.Event(), threading.Event()
+    original = graph.vec_db.update
+
+    def wait(identifier, data):
+        if data["payload"]["status"] == "deleted":
+            began.set()
+            assert release.wait(5)
+        original(identifier, data)
+
+    graph.vec_db.update = wait
+    with ThreadPoolExecutor(2) as pool:
+        deleted = pool.submit(transition, first)
+        assert began.wait(5)
+        restored = pool.submit(transition, second, "restore", "opposite")
+        release.set()
+        assert deleted.result()["state"] == restored.result()["state"] == "confirmed"
+    assert graph.rows["m1"]["metadata"]["status"] == graph.vec_db.payload["status"] == "activated"
+
+
+def test_explicit_never_indexed_graph_only_record(tmp_path):
+    svc = service(tmp_path)
+    svc.graph.vec_db.payload = None
+    svc.graph.rows["m1"]["metadata"]["vector_sync"] = "not_indexed"
+    assert transition(svc)["state"] == "confirmed"
+
+
+def test_running_worker_retries_without_service_restart(tmp_path):
+    import time
+
+    from memos.api.memory_lifecycle import LifecycleWorker
+
+    svc = service(tmp_path)
+    svc.graph.vec_db.offline = True
+    assert transition(svc)["state"] == "pending"
+    worker = LifecycleWorker(lambda: svc, interval=0.02)
+    worker.start()
+    try:
+        svc.graph.vec_db.offline = False
+        deadline = time.monotonic() + 3
+        while time.monotonic() < deadline:
+            result = svc.get_operation("a", "delete-1")
+            if result["state"] == "confirmed":
+                break
+            time.sleep(0.02)
+        assert result["state"] == "confirmed" and result["attempts"] >= 2
+    finally:
+        worker.stop()
