+from memos.api.cloud_store import JsonMetadataStore
+from memos.api.profile import PROFILE_INSTANCE_KIND, ProfileService
+
+
+def fixture_service(tmp_path):
+    store = JsonMetadataStore(tmp_path)
+    service = ProfileService(store)
+    ids = []
+    for n, (tenant, kind) in enumerate([("a", "user"), ("a", "agent"), ("b", "user")]):
+        identifier = "profile_" + f"{n:032x}"
+        ids.append(identifier)
+        store.put(
+            PROFILE_INSTANCE_KIND,
+            {
+                "entity_id": identifier,
+                "user_name": tenant,
+                "subject_type": kind,
+                "subject_id": f"subject-{n}",
+                "status": "bound",
+                "template_id": "template-1",
+                "created_at": f"2026-01-0{n + 1}T00:00:00+00:00",
+                "updated_at": "2026-02-01T00:00:00+00:00",
+                "fields": {
+                    "basic.user_name": {"value": f"Marker-{n}"},
+                    "城市": {"value": "杭州"},
+                    "empty": {"value": None},
+                    "old": {"value": "hidden", "deprecated": True},
+                    "deleted": {"value": "hidden", "status": "deleted"},
+                },
+            },
+        )
+    return service, store, ids
+
+
+def test_project_rows_cover_subjects_paginate_and_keep_stable_ids(tmp_path):
+    service, _, ids = fixture_service(tmp_path)
+    rows, total = service.list_field_rows(user_name="a", page=1, page_size=2)
+    rest, second_total = service.list_field_rows(user_name="a", page=2, page_size=2)
+    assert total == second_total == 4
+    assert len(rows) == len(rest) == 2
+    assert {row["subject_type"] for row in rows + rest} == {"user", "agent"}
+    assert len({row["id"] for row in rows + rest}) == 4
+    assert rows[0]["profile_instance_id"] == ids[1]
+    for row in rows + rest:
+        assert service.get_field_row(user_name="a", memory_id=row["id"]) == row
+        assert service.get_field_row(user_name="b", memory_id=row["id"]) is None
+
+
+def test_profile_filters_before_total_and_paging(tmp_path):
+    service, _, _ = fixture_service(tmp_path)
+    rows, total = service.list_field_rows(
+        user_name="a", subject_type="user", search="marker", page_size=1
+    )
+    assert total == 1 and rows[0]["subject_id"] == "subject-0"
+    assert service.list_field_rows(user_name="a", subject_id="subject-1")[1] == 2
+    assert service.list_field_rows(user_name="a", start_time="2026-01-02T00:00:00+00:00")[1] == 2
+    assert (
+        service.list_field_rows(
+            user_name="a", end_time="2026-01-02T00:00:00+00:00", end_exclusive=True
+        )[1]
+        == 2
+    )
+    assert service.list_field_rows(user_name="a", knowledgebase_id="not-linked")[1] == 0
+    assert service.list_field_rows(user_name="missing")[1] == 0
+
+
+def test_profile_unicode_path_detached_and_invalid_ids(tmp_path):
+    service, store, ids = fixture_service(tmp_path)
+    assert (
+        service.get_field_row(user_name="a", memory_id=ids[0] + "_城市")["memory"] == "城市: 杭州"
+    )
+    assert service.get_field_row(user_name="a", memory_id=ids[0] + "_basic.user_name")
+    for suffix in ["_empty", "_old", "_deleted", "_missing"]:
+        assert service.get_field_row(user_name="a", memory_id=ids[0] + suffix) is None
+    assert service.get_field_row(user_name="a", memory_id="../bad") is None
+    instance = store.get(PROFILE_INSTANCE_KIND, ids[0])
+    instance["status"] = "detached"
+    store.put(PROFILE_INSTANCE_KIND, instance)
+    assert service.get_field_row(user_name="a", memory_id=ids[0] + "_城市") is None
