@@ -0,0 +1,75 @@
+"""Revalidate recall against authoritative state, including during vector outage."""
+
+from typing import Any
+
+from memos.api.memory_state import read_control_node
+from memos.memories.textual.two_stage import two_stage_enabled
+
+
+def confirm_current_memories(results: dict | None, graph: Any, profiles: Any) -> dict | None:
+    allowed = {"activated", "resolving"} if two_stage_enabled() else {"activated"}
+    for tab, groups in (results or {}).items():
+        if not isinstance(groups, list):
+            continue
+        for group in groups:
+            if not isinstance(group, dict) or not isinstance(group.get("memories"), list):
+                continue
+            cube = group.get("cube_id")
+            kept = []
+            for memory in group["memories"]:
+                if (
+                    not isinstance(memory, dict)
+                    or not isinstance(memory.get("id"), str)
+                    or not cube
+                ):
+                    continue
+                if tab == "profile_mem":
+                    current = (
+                        profiles.get_field_row(user_name=cube, memory_id=memory["id"])
+                        if profiles
+                        else None
+                    )
+                    if current:
+                        kept.append(memory)
+                    continue
+                # No exception fallback: the API must fail if graph truth cannot be read.
+                node = read_control_node(graph, memory["id"], cube)
+                if not isinstance(node, dict):
+                    continue
+                metadata = node.get("metadata") or {}
+                status = metadata.get("status")
+                if metadata.get("user_name") != cube:
+                    continue
+                if status in allowed or (
+                    tab == "dream_mem" and status in {"completed", "context_only", "skipped"}
+                ):
+                    memory.setdefault("metadata", {})["status"] = status
+                    kept.append(memory)
+            group["memories"] = kept
+            if "total_nodes" in group:
+                group["total_nodes"] = len(kept)
+    return results
+
+
+def filter_current_subgraph(subgraph: dict, graph: Any, cube: str) -> dict:
+    """Legacy get_all searches also contain graph neighbors and incident edges."""
+    nodes = []
+    for node in subgraph.get("nodes") or []:
+        current = read_control_node(graph, node["id"], cube)
+        metadata = current.get("metadata") if current else None
+        if (
+            metadata
+            and metadata.get("user_name") == cube
+            and metadata.get("status") not in (None, "deleted")
+        ):
+            nodes.append(node)
+    identifiers = {node["id"] for node in nodes}
+    return {
+        "core_id": subgraph.get("core_id") if subgraph.get("core_id") in identifiers else None,
+        "nodes": nodes,
+        "edges": [
+            edge
+            for edge in subgraph.get("edges") or []
+            if edge.get("source") in identifiers and edge.get("target") in identifiers
+        ],
+    }
