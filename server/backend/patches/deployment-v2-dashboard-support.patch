+"""Saved project templates must reach the actual multimodal chat reader."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+from memos.context.context import ContextThreadPoolExecutor
+from memos.mem_reader.multi_modal_struct import MultiModalStructMemReader
+from memos.mem_reader.prompt_config import use_base_extract_prompt
+
+
+def test_project_chat_template_reaches_worker_without_leaking_to_next_request():
+    reader = object.__new__(MultiModalStructMemReader)
+    reader.config = SimpleNamespace(remove_prompt_example=False)
+    reader.llm = Mock()
+    reader.llm.generate.return_value = '{"memory list": [], "summary": ""}'
+    with ContextThreadPoolExecutor(max_workers=1) as executor:
+        with use_base_extract_prompt("PROJECT_RULE ${conversation} ${custom_tags_prompt}"):
+            executor.submit(reader._get_llm_response, "user: stable policy", ["policy"]).result()
+        configured = reader.llm.generate.call_args.args[0][0]["content"]
+        assert "PROJECT_RULE" in configured
+        assert "user: stable policy" in configured
+        assert "${conversation}" not in configured
+        executor.submit(reader._get_llm_response, "user: another project").result()
+        ordinary = reader.llm.generate.call_args.args[0][0]["content"]
+        assert "PROJECT_RULE" not in ordinary
+        with use_base_extract_prompt("PROJECT_RULE ${conversation}"):
+            executor.submit(reader._get_llm_response, "file content", None, None, "doc").result()
+        assert "PROJECT_RULE" not in reader.llm.generate.call_args.args[0][0]["content"]
+
+
+def test_runtime_accepts_memory_list_alias_used_by_debug_extraction():
+    reader = object.__new__(MultiModalStructMemReader)
+    reader.config = SimpleNamespace(remove_prompt_example=False)
+    reader.llm = Mock()
+    reader.llm.generate.return_value = '{"memory_list": [{"value": "stable fact"}], "summary": ""}'
+    with use_base_extract_prompt("Saved rule ${conversation}"):
+        result = reader._get_llm_response("user: stable fact")
+    assert result["memory list"] == [{"value": "stable fact"}]
+
+
+def test_multi_cube_fanout_loads_each_project_template(tmp_path, monkeypatch):
+    from memos.mem_reader.prompt_config import (
+        current_base_extract_prompt,
+        save_prompt,
+        use_project_extract_prompt,
+    )
+    from memos.multi_mem_cube.composite_cube import CompositeCubeView
+
+    monkeypatch.setenv("MEMOS_PROMPT_CONFIG_DB", str(tmp_path / "prompts.db"))
+    save_prompt("a", "PROJECT_A ${conversation}")
+    save_prompt("b", "PROJECT_B ${conversation}")
+
+    def capture(request):
+        return [{"prompt": current_base_extract_prompt()}]
+
+    views = [
+        SimpleNamespace(cube_id=cube, add_memories=capture, extract_memories=capture)
+        for cube in ("a", "b", "unset")
+    ]
+    composite = CompositeCubeView(cube_views=views, logger=Mock())
+    with use_project_extract_prompt("a"):
+        for method in (composite.add_memories, composite.extract_memories):
+            assert [r["prompt"] for r in method(Mock())] == [
+                "PROJECT_A ${conversation}",
+                "PROJECT_B ${conversation}",
+                None,
+            ]
