+def load_tenants_file(
+    path: str | os.PathLike[str] | None, *, blocking: bool = True
+) -> dict[str, Tenant]:
+    """Load only a confirmed publication, never a precommit or unreconciled file."""
+    if not path:
+        return {}
+    path = Path(path)
+    if not path.parent.exists():
+        return {}
+    with _manifest_lock(path, blocking=blocking):
+        if path.with_name(path.name + ".pending").exists():
+            raise ValueError(
+                "Tenant configuration awaits dashboard reconciliation; refusing startup"
+            )
+        try:
+            text = path.read_text(encoding="utf-8")
+        except FileNotFoundError:
+            return {}
+        return parse_tenants(text)
