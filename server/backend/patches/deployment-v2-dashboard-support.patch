+"""Request-time file change detection; no static token cache survives revocation."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from anyio import to_thread
+from fastmcp.server.auth import AccessToken, TokenVerifier
+
+
+if TYPE_CHECKING:
+    from .domain.tenants import TenantRegistry
+
+
+class ReloadingTokenVerifier(TokenVerifier):
+    def __init__(self, tenants: TenantRegistry):
+        super().__init__()
+        self._tenants = tenants
+
+    async def verify_token(self, token: str) -> AccessToken | None:
+        tenant = await to_thread.run_sync(self._tenants.authenticate, token)
+        if tenant is None:
+            return None
+        claims = {
+            "client_id": tenant.user_id,
+            "scopes": ["memory"],
+            "user_id": tenant.user_id,
+            "cube_id": tenant.cube_id,
+        }
+        return AccessToken(token=token, client_id=tenant.user_id, scopes=["memory"], claims=claims)
