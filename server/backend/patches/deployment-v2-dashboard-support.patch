+            end_time=request.end_time.isoformat() if request.end_time else None,
+            end_exclusive=request.end_exclusive,
+            page=request.page,
+            page_size=request.page_size,
+        )
+        return GetMemoryResponse(
+            message="Profile fields retrieved",
+            data={
+                "cube_id": request.mem_cube_id,
+                "memories": rows,
+                "total": total,
+                "page": request.page,
+                "page_size": request.page_size,
+            },
+        )
+
+    @router.post("/get_profile_memory", response_model=GetMemoryResponse)
+    def get_profile_memory(request: ProfileMemoryGetRequest) -> GetMemoryResponse:
+        row = service_factory().get_field_row(
+            user_name=request.mem_cube_id, memory_id=request.memory_id
+        )
+        return GetMemoryResponse(
+            message="Profile field retrieved" if row else "Not found", data=row
+        )
+
+    return router
