+"""Read-only profile field routes, testable without initializing a model service."""
+
+from collections.abc import Callable
+
+from fastapi import APIRouter
+
+from memos.api.product_models import (
+    GetMemoryResponse,
+    ProfileMemoryGetRequest,
+    ProfileMemoryListRequest,
+)
+from memos.api.profile import ProfileService
+
+
+def create_profile_memory_router(service_factory: Callable[[], ProfileService]) -> APIRouter:
+    router = APIRouter()
+
+    @router.post("/list_profile_memories", response_model=GetMemoryResponse)
+    def list_profile_memories(request: ProfileMemoryListRequest) -> GetMemoryResponse:
+        rows, total = service_factory().list_field_rows(
+            user_name=request.mem_cube_id,
+            subject_type=request.subject_type,
+            subject_id=request.subject_id,
+            search=request.search,
+            knowledgebase_id=request.knowledgebase_id,
