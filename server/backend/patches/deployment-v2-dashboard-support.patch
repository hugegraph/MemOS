+    def _signature(self) -> tuple:
+        path = self._path
+        return self._stat(path), self._stat(path.with_name(path.name + ".pending"))
+
+    def _refresh(self, *, strict: bool = False) -> None:
+        if self._path is None:
+            return
+        with self._refresh_lock:
+            try:
+                before = self._signature()
+                if before == self._version:
+                    return
+                extra = load_tenants_file(self._path, blocking=strict)
+                after = self._signature()
