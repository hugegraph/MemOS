@@ -0,0 +1,90 @@
+"""Trusted control-plane lifecycle routes, separate from ordinary read APIs."""
+
+from collections.abc import Callable
+from typing import Literal
+
+from fastapi import APIRouter
+from pydantic import BaseModel, ConfigDict, Field
+
+from memos.api.memory_lifecycle import LifecycleError, MemoryLifecycle
+from memos.api.memory_state import read_control_node
+from memos.api.product_models import GetMemoryResponse
+
+
+class OperationRequest(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    mem_cube_id: str = Field(min_length=1, max_length=128, pattern=r"^[A-Za-z0-9_.-]+$")
+    operation_id: str = Field(min_length=1, max_length=128, pattern=r"^[A-Za-z0-9_.-]+$")
+
+
+class LifecycleProbeRequest(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    mem_cube_id: str = Field(min_length=1, max_length=128, pattern=r"^[A-Za-z0-9_.-]+$")
+    memory_id: str = Field(min_length=1, max_length=1024, pattern=r"^[^\x00-\x1f\x7f]+$")
+    kind: Literal["graph", "profile"] = "graph"
+
+
+class TransitionMemoryRequest(LifecycleProbeRequest):
+    target_status: Literal["deleted", "restore"]
+    operation_id: str = Field(min_length=1, max_length=128, pattern=r"^[A-Za-z0-9_.-]+$")
+
+
+def create_lifecycle_router(factory: Callable[[], MemoryLifecycle]) -> APIRouter:
+    router = APIRouter()
+
+    def execute(request, kind):
+        if request.kind != kind:
+            return GetMemoryResponse(
+                code=400, message="Lifecycle kind does not match route", data=None
+            )
+        try:
+            result = factory().transition(
+                cube=request.mem_cube_id,
+                memory_id=request.memory_id,
+                operation_id=request.operation_id,
+                target_status=request.target_status,
+                kind=kind,
+            )
+            return GetMemoryResponse(message="Lifecycle transition evaluated", data=result)
+        except LifecycleError as exc:
+            return GetMemoryResponse(code=exc.code, message=str(exc), data=None)
+
+    @router.post("/transition_memory", response_model=GetMemoryResponse)
+    def transition_memory(request: TransitionMemoryRequest):
+        return execute(request, "graph")
+
+    @router.post("/transition_profile_memory", response_model=GetMemoryResponse)
+    def transition_profile(request: TransitionMemoryRequest):
+        return execute(request, "profile")
+
+    @router.post("/inspect_memory_lifecycle", response_model=GetMemoryResponse)
+    def inspect(request: LifecycleProbeRequest):
+        service = factory()
+        if request.kind == "profile":
+            found = service.profiles.lifecycle_field(request.mem_cube_id, request.memory_id)
+            metadata = {**found[1], "memory_type": "ProfileMemory"} if found else None
+        else:
+            node = read_control_node(service.graph, request.memory_id, request.mem_cube_id)
+            metadata = node.get("metadata") if node else None
+            if metadata and metadata.get("user_name") != request.mem_cube_id:
+                metadata = None
+        if metadata is None:
+            return GetMemoryResponse(code=404, message="Memory not found", data=None)
+        return GetMemoryResponse(
+            message="Lifecycle state inspected",
+            data={
+                "memory_id": request.memory_id,
+                "status": metadata.get("status", "activated"),
+                "previous_status": metadata.get("previous_status"),
+                "memory_type": metadata.get("memory_type"),
+            },
+        )
+
+    @router.post("/get_memory_operation", response_model=GetMemoryResponse)
+    def operation(request: OperationRequest):
+        return GetMemoryResponse(
+            message="Lifecycle operation retrieved",
+            data=factory().get_operation(request.mem_cube_id, request.operation_id),
+        )
+
+    return router
