@@ -0,0 +1,217 @@
+"""Credential publications become effective on the next authenticated HTTP request."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import sys
+
+from dataclasses import replace
+from pathlib import Path
+
+import pytest
+
+from starlette.testclient import TestClient
+
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+from gateway.app import build_app
+from gateway.config import settings
+from gateway.domain.tenants import TenantRegistry
+
+
+def publish(path, values):
+    temporary = path.with_suffix(".next")
+    temporary.write_text(json.dumps(values), encoding="utf-8")
+    os.replace(temporary, path)
+
+
+def registry(path):
+    return TenantRegistry.from_sources("env-token:operator", str(path))
+
+
+def test_add_revoke_and_identity_remap(tmp_path):
+    path = tmp_path / "tenants.conf"
+    publish(path, {"first": "alice"})
+    tenants = registry(path)
+    assert tenants.authenticate("first").user_id == "alice"
+    publish(path, {"second": {"user_id": "bob", "cube_id": "team-b"}})
+    assert tenants.authenticate("first") is None
+    assert tenants.authenticate("second").cube_id == "team-b"
+    assert tenants.get("second").user_id == "bob"  # audit shares the live snapshot
+    publish(path, {"second": "carol"})
+    assert tenants.authenticate("second").user_id == "carol"
+    assert tenants.authenticate("env-token").user_id == "operator"
+
+
+@pytest.mark.parametrize("failure", ["invalid", "pending", "missing", "conflict"])
+def test_bad_publication_fails_closed_and_recovers(tmp_path, failure):
+    path = tmp_path / "tenants.conf"
+    publish(path, {"first": "alice"})
+    tenants = registry(path)
+    if failure == "invalid":
+        path.write_text('{"credential-secret":', encoding="utf-8")
+    elif failure == "pending":
+        path.with_name(path.name + ".pending").write_text("pending")
+    elif failure == "missing":
+        path.unlink()
+    else:
+        publish(path, {"env-token": "mallory"})
+    assert tenants.authenticate("first") is None
+    assert tenants.authenticate("credential-secret") is None
+    assert tenants.authenticate("env-token").user_id == "operator"
+    path.with_name(path.name + ".pending").unlink(missing_ok=True)
+    publish(path, {"second": "bob"})
+    assert tenants.authenticate("second").user_id == "bob"
+    assert tenants.authenticate("first") is None
+
+
+def test_unchanged_file_is_not_reparsed_and_same_mtime_replacement_detected(tmp_path, monkeypatch):
+    import gateway.domain.tenants as module
+
+    path = tmp_path / "tenants.conf"
+    publish(path, {"first": "alice"})
+    tenants = registry(path)
+    original = module.parse_tenants
+    calls = []
+
+    def parse(value):
+        calls.append(True)
+        return original(value)
+
+    monkeypatch.setattr(module, "parse_tenants", parse)
+    for _ in range(10):
+        assert tenants.authenticate("first")
+    assert calls == []
+    timestamp = path.stat().st_mtime_ns
+    publish(path, {"other": "bobby"})
+    os.utime(path, ns=(timestamp, timestamp))
+    assert tenants.authenticate("other").user_id == "bobby"
+    assert calls == [True]
+
+
+def test_file_read_failure_revokes_cached_file_keys(tmp_path, monkeypatch):
+    import gateway.domain.tenants as module
+
+    path = tmp_path / "tenants.conf"
+    publish(path, {"first": "alice"})
+    tenants = registry(path)
+    publish(path, {"second": "bob"})
+    original = module.load_tenants_file
+
+    def denied(*args, **kwargs):
+        raise PermissionError("sensitive source must not escape")
+
+    monkeypatch.setattr(module, "load_tenants_file", denied)
+    assert tenants.authenticate("first") is None
+    assert tenants.authenticate("env-token")
+    monkeypatch.setattr(module, "load_tenants_file", original)
+    assert tenants.authenticate("second")
+
+
+def test_publication_lock_does_not_block_auth_and_recovers(tmp_path):
+    from gateway.domain.tenants import _manifest_lock
+
+    path = tmp_path / "tenants.conf"
+    publish(path, {"first": "alice"})
+    tenants = registry(path)
+    marker = path.with_name(path.name + ".pending")
+    with _manifest_lock(path):
+        marker.write_text("pending")
+        publish(path, {"second": "bob"})
+        assert tenants.authenticate("first") is None
+        assert tenants.authenticate("second") is None
+        assert tenants.authenticate("env-token")
+        marker.unlink()
+    assert tenants.authenticate("second")
+
+
+def test_change_between_read_and_stat_never_accepts_mixed_publication(tmp_path, monkeypatch):
+    import gateway.domain.tenants as module
+
+    path = tmp_path / "tenants.conf"
+    publish(path, {"first": "alice"})
+    tenants = registry(path)
+    original = module.load_tenants_file
+    publish(path, {"second": "bob"})
+
+    def racing(*args, **kwargs):
+        loaded = original(*args, **kwargs)
+        publish(path, {"third": "carol"})
+        return loaded
+
+    monkeypatch.setattr(module, "load_tenants_file", racing)
+    assert tenants.authenticate("second") is None
+    monkeypatch.setattr(module, "load_tenants_file", original)
+    assert tenants.authenticate("third").user_id == "carol"
+
+
+def test_empty_startup_stays_authenticated_and_live_http_rechecks_each_request(tmp_path):
+    path = tmp_path / "tenants.conf"
+    publish(path, {})
+    app = build_app(
+        replace(
+            settings,
+            tenants_raw="",
+            tenants_file=str(path),
+            call_log_dir=str(tmp_path / "calls"),
+            audit_log_dir=str(tmp_path / "audit"),
+        )
+    )
+    rpc = {"jsonrpc": "2.0", "id": 1, "method": "tools/list", "params": {}}
+    with TestClient(app.mcp.http_app(middleware=[app.http_middleware()])) as web:
+
+        def request(token):
+            return web.post(
+                "/mcp",
+                json=rpc,
+                headers={
+                    "Authorization": "Bearer " + token,
+                    "Accept": "application/json, text/event-stream",
+                },
+            )
+
+        assert web.post("/mcp", json=rpc).status_code == 401
+        assert request("first").status_code == 401
+        publish(path, {"first": "alice"})
+        assert request("first").status_code == 200
+        publish(path, {})
+        assert request("first").status_code == 401
+        publish(path, {"second": "bob"})
+        assert request("second").status_code == 200
+        assert request("first").status_code == 401
+
+
+def test_auth_disk_work_does_not_block_event_loop(tmp_path, monkeypatch):
+    import threading
+
+    from gateway.live_auth import ReloadingTokenVerifier
+
+    path = tmp_path / "tenants.conf"
+    publish(path, {"first": "alice"})
+    tenants = registry(path)
+    entered, released = threading.Event(), threading.Event()
+    original = tenants.authenticate
+
+    def slow(token):
+        entered.set()
+        assert released.wait(3)
+        return original(token)
+
+    monkeypatch.setattr(tenants, "authenticate", slow)
+
+    async def run():
+        task = asyncio.create_task(ReloadingTokenVerifier(tenants).verify_token("first"))
+        for _ in range(100):
+            if entered.is_set():
+                break
+            await asyncio.sleep(0.001)
+        try:
+            assert entered.is_set() and not task.done()
+        finally:
+            released.set()
+        assert (await task).claims["user_id"] == "alice"
+
+    asyncio.run(run())
