+import importlib
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from memos.api.cloud_store import JsonMetadataStore
+from memos.api.profile import PROFILE_INSTANCE_KIND, ProfileService
+
+
+def test_profile_read_routes_have_tenant_scoped_envelopes(tmp_path):
+    module = importlib.import_module("memos.api.profile_memory_routes")
+    service = ProfileService(JsonMetadataStore(tmp_path))
+    identifier = "profile_" + "a" * 32
+    service.store.put(
+        PROFILE_INSTANCE_KIND,
+        {
+            "entity_id": identifier,
+            "user_name": "cube-a",
+            "status": "bound",
+            "subject_type": "user",
+            "subject_id": "u1",
+            "template_id": "t1",
+            "created_at": "2026-01-01T00:00:00Z",
+            "fields": {"name_中文": {"value": "Marker"}},
+        },
+    )
+    app = FastAPI()
+    app.include_router(module.create_profile_memory_router(lambda: service), prefix="/product")
+    with TestClient(app) as client:
+        response = client.post("/product/list_profile_memories", json={"mem_cube_id": "cube-a"})
+        assert response.status_code == 200
+        data = response.json()["data"]
+        assert response.json()["code"] == 200
+        assert data["total"] == 1 and data["cube_id"] == "cube-a"
+        row = data["memories"][0]
+        response = client.post(
+            "/product/get_profile_memory", json={"mem_cube_id": "cube-a", "memory_id": row["id"]}
+        )
+        assert response.json()["data"] == row
+        assert (
+            client.post(
+                "/product/get_profile_memory",
+                json={"mem_cube_id": "cube-b", "memory_id": row["id"]},
+            ).json()["data"]
+            is None
+        )
+        assert client.post("/product/list_profile_memories", json={}).status_code == 422
+        assert (
+            client.post(
+                "/product/list_profile_memories", json={"mem_cube_id": "cube-a", "page": 0}
+            ).status_code
+            == 422
+        )
+        assert (
+            client.post(
+                "/product/list_profile_memories",
+                json={"mem_cube_id": "cube-a", "start_time": "2026-01-01T00:00:00"},
+            ).status_code
+            == 422
+        )
