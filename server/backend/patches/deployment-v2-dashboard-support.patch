+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from test_memory_lifecycle import service
+
+
+def test_routes_transition_probe_restore_operation_and_errors(tmp_path):
+    from memos.api.memory_lifecycle_routes import create_lifecycle_router
+
+    svc = service(tmp_path)
+    app = FastAPI()
+    app.include_router(create_lifecycle_router(lambda: svc), prefix="/product")
+    with TestClient(app) as client:
+        base = {"mem_cube_id": "a", "memory_id": "m1", "kind": "graph"}
+        assert (
+            client.post("/product/inspect_memory_lifecycle", json=base).json()["data"]["status"]
+            == "activated"
+        )
+        request = {**base, "operation_id": "route-delete", "target_status": "deleted"}
+        response = client.post("/product/transition_memory", json=request)
+        assert response.json()["code"] == 200 and response.json()["data"]["success"]
+        assert (
+            client.post(
+                "/product/get_memory_operation",
+                json={"mem_cube_id": "a", "operation_id": "route-delete"},
+            ).json()["data"]["state"]
+            == "confirmed"
+        )
+        assert (
+            client.post(
+                "/product/transition_memory", json={**request, "target_status": "restore"}
+            ).json()["code"]
+            == 409
+        )
+        assert client.post(
+            "/product/transition_memory",
+            json={**request, "operation_id": "restore", "target_status": "restore"},
+        ).json()["data"]["success"]
+        assert (
+            client.post(
+                "/product/inspect_memory_lifecycle", json={**base, "mem_cube_id": "b"}
+            ).json()["code"]
+            == 404
+        )
+        assert (
+            client.post(
+                "/product/transition_memory", json={**request, "operation_id": "../bad"}
+            ).status_code
+            == 422
+        )
