@@ -0,0 +1,86 @@
+"""Crash-released control locks shared across workers using the metadata backend."""
+
+import hashlib
+import os
+import threading
+import time
+import weakref
+
+from collections.abc import Callable, Iterator
+from contextlib import contextmanager
+from functools import wraps
+
+from memos.api.cloud_store import JsonMetadataStore, MetadataStore, Neo4jMetadataStore
+
+
+_registry_guard = threading.Lock()
+_registry = weakref.WeakValueDictionary()
+
+
+@contextmanager
+def control_lock(store: MetadataStore, key: str) -> Iterator[None]:
+    digest = hashlib.sha256(key.encode()).hexdigest()
+    identity = (str(getattr(store, "root", "neo4j")), digest)
+    with _registry_guard:
+        lock = _registry.setdefault(identity, threading.RLock())
+    with lock:
+        if isinstance(store, Neo4jMetadataStore):
+            if not getattr(store, "_control_constraint_ready", False):
+                with store._session() as session:
+                    session.run(
+                        "CREATE CONSTRAINT cloud_entity_id_unique IF NOT EXISTS "
+                        "FOR (n:CloudEntity) REQUIRE n.entity_id IS UNIQUE"
+                    ).consume()
+                store._control_constraint_ready = True
+            with store._session() as session, session.begin_transaction() as tx:
+                tx.run(
+                    "MERGE (n:CloudEntity {entity_id: $id}) "
+                    "SET n.entity_kind='control_lock', n.lock_version=coalesce(n.lock_version,0)+1",
+                    id="control-lock-" + digest,
+                ).consume()
+                yield
+                # The transaction's exclusive node lock is released even after process death.
+                tx.commit()
+        elif isinstance(store, JsonMetadataStore):
+            directory = store.root / ".control-locks"
+            directory.mkdir(parents=True, exist_ok=True)
+            with (directory / digest).open("a+b") as handle:
+                handle.write(b"0")
+                handle.flush()
+                if os.name == "nt":
+                    import msvcrt
+
+                    deadline = time.monotonic() + 60
+                    while True:
+                        try:
+                            handle.seek(0)
+                            msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
+                            break
+                        except OSError:
+                            if time.monotonic() > deadline:
+                                raise TimeoutError("Control lock acquisition timed out") from None
+                            time.sleep(0.02)
+                    try:
+                        yield
+                    finally:
+                        handle.seek(0)
+                        msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
+                else:
+                    import fcntl
+
+                    fcntl.flock(handle, fcntl.LOCK_EX)
+                    try:
+                        yield
+                    finally:
+                        fcntl.flock(handle, fcntl.LOCK_UN)
+        else:
+            raise TypeError("Lifecycle requires a persistent metadata store with control locks")
+
+
+def serialized_profile_write(method: Callable) -> Callable:
+    @wraps(method)
+    def wrapped(self, *args, **kwargs):
+        with control_lock(self.store, "profile-writes"):
+            return method(self, *args, **kwargs)
+
+    return wrapped
