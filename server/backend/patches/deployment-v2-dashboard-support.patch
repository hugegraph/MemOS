+++ b/src/memos/api/memory_lifecycle.py
@@ -0,0 +1,261 @@
+"""Durable, idempotent graph/vector transitions; no best-effort success."""
+
+import hashlib
+import json
+import threading
+
+from collections.abc import Callable
+from datetime import datetime, timezone
+from typing import Any
+
+from memos.api.cloud_store import MetadataStore
+from memos.api.control_lock import control_lock
+from memos.api.memory_state import read_control_node
+from memos.log import get_logger
+
+
+logger = get_logger(__name__)
+INTENT_KIND = "memory_lifecycle"
+
+
+class LifecycleError(ValueError):
+    def __init__(self, code: int, message: str):
+        self.code = code
+        super().__init__(message)
+
+
+def now() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def operation_key(cube: str, operation_id: str) -> str:
+    return "lifecycle-" + hashlib.sha256(json.dumps([cube, operation_id]).encode()).hexdigest()
+
+
+class MemoryLifecycle:
+    def __init__(self, store: MetadataStore, graph: Any, profiles: Any | None = None) -> None:
+        self.store, self.graph, self.profiles = store, graph, profiles
+
+    def transition(
+        self,
+        *,
+        cube: str,
+        memory_id: str,
+        target_status: str,
+        operation_id: str,
+        kind: str = "graph",
+    ) -> dict[str, Any]:
+        if target_status not in ("deleted", "restore") or kind not in ("graph", "profile"):
+            raise LifecycleError(400, "Unsupported lifecycle transition")
+        key = operation_key(cube, operation_id)
+        with (
+            control_lock(self.store, "operation:" + key),
+            control_lock(self.store, self._resource(cube, memory_id, kind)),
+        ):
+            intent = self.store.get(INTENT_KIND, key)
+            if intent:
+                if (intent["memory_id"], intent["requested_status"], intent["kind"]) != (
+                    memory_id,
+                    target_status,
+                    kind,
+                ):
+                    raise LifecycleError(409, "Operation ID already used for different arguments")
+                return (
+                    self._apply(intent) if intent["state"] != "confirmed" else self._public(intent)
+                )
+            # Complete older writes before admitting the opposite operation.
+            for pending in self.store.list(INTENT_KIND, user_name=cube):
+                if (
+                    pending["memory_id"] == memory_id
+                    and pending["kind"] == kind
+                    and pending["state"] != "confirmed"
+                ):
+                    result = self._apply(pending)
+                    if not result["success"]:
+                        raise LifecycleError(409, "Previous transition is still pending")
+            if kind == "profile":
+                current = self.profiles.lifecycle_field(cube, memory_id)
+                metadata = current[1] if current else None
+            else:
+                node = read_control_node(self.graph, memory_id, cube)
+                metadata = node.get("metadata") if node else None
+            if metadata is None or (kind == "graph" and metadata.get("user_name") != cube):
+                raise LifecycleError(404, "Memory not found in this cube")
+            status = metadata.get("status", "activated" if kind == "profile" else None)
+            if target_status == "deleted":
+                if status != "activated":
+                    raise LifecycleError(409, "Only activated memories may be deleted")
+                target, previous = "deleted", status
+            else:
+                previous = metadata.get("previous_status")
+                if status != "deleted" or previous != "activated":
+                    raise LifecycleError(409, "Memory is not recoverable")
+                target = previous
+            intent = {
+                "entity_id": key,
+                "user_name": cube,
+                "operation_id": operation_id,
+                "memory_id": memory_id,
+                "kind": kind,
+                "requested_status": target_status,
+                "target_status": target,
+                "previous_status": previous,
+                "state": "pending",
+                "phase": "prepared",
+                "attempts": 0,
+                "created_at": now(),
+                "updated_at": now(),
+            }
+            self.store.put(INTENT_KIND, intent)  # Must succeed BEFORE changing memory.
+            return self._apply(intent)
+
+    @staticmethod
+    def _resource(cube, memory_id, kind):
+        # Profile writers and transitions serialize complete instance documents.
+        return "profile-writes" if kind == "profile" else "memory:" + json.dumps([cube, memory_id])
+
+    def _apply(self, intent):
+        if intent["state"] == "confirmed":
+            return self._public(intent)
+        intent["attempts"] += 1
+        intent["updated_at"] = now()
+        try:
+            cube, identifier, target = (
+                intent["user_name"],
+                intent["memory_id"],
+                intent["target_status"],
+            )
+            fields = {
+                "status": target,
+                "previous_status": intent["previous_status"],
+                "deleted_at": intent["created_at"] if target == "deleted" else "",
+                "lifecycle_operation_id": intent["operation_id"],
+            }
+            if intent["kind"] == "profile":
+                self.profiles.apply_field_lifecycle(cube, identifier, fields)
+                found = self.profiles.lifecycle_field(cube, identifier)
+                if not found or found[1].get("status") != target:
+                    raise OSError("Profile status verification failed")
+                intent["vector_state"] = "not_applicable"
+            else:
+                node = read_control_node(self.graph, identifier, cube)
+                if not node or node["metadata"].get("user_name") != cube:
+                    raise OSError("Memory vanished during transition")
+                self._write_graph(identifier, cube, fields)
+                intent["phase"] = "graph_written"
+                self.store.put(INTENT_KIND, intent)
+                vector = getattr(self.graph, "vec_db", None)
+                if vector is None:
+                    raise OSError("Vector backend cannot be verified")
+                point = vector.get_by_id(identifier)  # Exceptions are NOT absence.
+                if point is None:
+                    if node["metadata"].get("vector_sync") != "not_indexed":
+                        raise OSError("Indexed vector point missing or indexing state unknown")
+                    intent["vector_state"] = "explicitly_not_indexed"
+                else:
+                    payload = point.payload or {}
+                    if payload.get("user_name") != cube:
+                        raise OSError("Vector ownership mismatch")
+                    vector.update(identifier, {"id": identifier, "payload": fields})
+                    verified = vector.get_by_id(identifier)
+                    if (
+                        not verified
+                        or (verified.payload or {}).get("status") != target
+                        or (verified.payload or {}).get("user_name") != cube
+                    ):
+                        raise OSError("Vector status verification failed")
+                    intent["vector_state"] = "confirmed"
+                current = read_control_node(self.graph, identifier, cube)
+                if not current or current["metadata"].get("status") != target:
+                    raise OSError("Graph status verification failed")
+            intent["state"], intent["phase"] = "confirmed", "confirmed"
+            intent.pop("last_error", None)
+        except Exception as exc:
+            intent["state"] = "pending"
+            intent["last_error"] = type(exc).__name__  # Never persist bodies/credentials.
+            logger.warning("Lifecycle transition pending (%s)", type(exc).__name__)
+        self.store.put(INTENT_KIND, intent)
+        return self._public(intent)
+
+    def get_operation(self, cube: str, operation_id: str) -> dict[str, Any] | None:
+        record = self.store.get(INTENT_KIND, operation_key(cube, operation_id))
+        return self._public(record) if record and record.get("user_name") == cube else None
+
+    def _write_graph(self, identifier, cube, fields):
+        driver = getattr(self.graph, "driver", None)
+        if driver is None:
+            # Backend-independent test doubles; production deployment uses Neo4j.
+            self.graph.update_node(identifier, dict(fields), user_name=cube)
+            return
+        # Do not invoke update_node's best-effort vector side effect: ownership
+        # and vector confirmation belong to this controlled transition.
+        with driver.session(database=self.graph.db_name) as session:
+            record = session.run(
+                "MATCH (n:Memory {id:$id, user_name:$cube}) SET n += $fields RETURN n.id AS id",
+                id=identifier,
+                cube=cube,
+                fields=fields,
+            ).single()
+            if record is None:
+                raise OSError("Graph lifecycle target not found")
+
+    @staticmethod
+    def _public(intent):
+        return {
+            **{
+                k: intent[k]
+                for k in (
+                    "operation_id",
+                    "memory_id",
+                    "kind",
+                    "target_status",
+                    "state",
+                    "phase",
+                    "attempts",
+                )
+            },
+            "success": intent["state"] == "confirmed",
+            "retryable": intent["state"] != "confirmed",
+            "vector_state": intent.get("vector_state", "unconfirmed"),
+        }
+
+    def reconcile(self) -> int:
+        completed = 0
+        for intent in self.store.list(INTENT_KIND):
+            if intent["state"] == "confirmed":
+                continue
+            try:
+                with control_lock(
+                    self.store,
+                    self._resource(intent["user_name"], intent["memory_id"], intent["kind"]),
+                ):
+                    current = self.store.get(INTENT_KIND, intent["entity_id"])
+                    if current and current["state"] != "confirmed":
+                        completed += int(self._apply(current)["success"])
+            except Exception as exc:
+                logger.warning("Lifecycle reconciliation deferred (%s)", type(exc).__name__)
+        return completed
+
+
+class LifecycleWorker:
+    def __init__(self, factory: Callable[[], MemoryLifecycle], interval: float = 5) -> None:
+        self.factory, self.interval = factory, interval
+        self.stop_event = threading.Event()
+        self.thread = None
+
+    def start(self) -> None:
+        def run():
+            while not self.stop_event.is_set():
+                try:
+                    self.factory().reconcile()
+                except Exception as exc:
+                    logger.warning("Lifecycle worker deferred (%s)", type(exc).__name__)
+                self.stop_event.wait(self.interval)
+
+        self.thread = threading.Thread(target=run, name="memory-lifecycle-reconcile", daemon=True)
+        self.thread.start()
+
+    def stop(self) -> None:
+        self.stop_event.set()
+        if self.thread:
+            self.thread.join(timeout=10)
