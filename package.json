{
  "name": "memos-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "test:mock": "node --test scripts/mock-api.test.mjs",
    "test:acceptance": "node --test scripts/acceptance.test.mjs",
    "test:api": "node --test scripts/mock-api.test.mjs scripts/acceptance.test.mjs",
    "test:live": "node --test server/live/*.test.mjs",
    "test:audit": "node --test server/live/audit.test.mjs server/live/audit-architecture.test.mjs",
    "test:audit:http": "node deploy/dashboard-bff/verify-performance.mjs",
    "test:issue": "node --test scripts/issue-acceptance/isolated/*.test.mjs scripts/issue-acceptance/contract/*.test.mjs",
    "test:issue:safety": "node --test scripts/issue-acceptance/real/*.test.mjs",
    "test:issue:real": "node scripts/issue-acceptance/real/full-run.mjs",
    "test:issue:http": "node scripts/issue-acceptance/real/runner.mjs",
    "test:issue:browser": "node scripts/issue-acceptance/browser/run.mjs",
    "live": "node --env-file-if-exists=.env.live server/live/server.mjs",
    "dev": "vite --port 5274 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5275 --strictPort",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "mock": "node --watch server/mock/server.ts",
    "dev:all": "concurrently -n mock,web -c cyan,green \"pnpm mock\" \"pnpm dev\""
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
