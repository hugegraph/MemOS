# 控制台后端 origin。
#   留空 = 同源，走 /api。开发态由 vite.config.ts 把 /api 代理到 mock 后端（pnpm mock）。
#   接真后端时改这里指向对方，前端代码一行不用动。
VITE_API_BASE=

# 记忆服务地址，用于落地页/文档/快速开始里展示的接入信息。
# 默认 http://localhost:8003
VITE_SERVICE_BASE=

# mock 后端（pnpm mock）
MOCK_PORT=5280
MOCK_DB=.data/mock-db.json

# 前端 /api 的代理目标，默认 http://localhost:5280（pnpm mock）。
# 指向已部署的后端就能直接看真实数据，不用再起 mock：
#   MOCK_ORIGIN=http://<后端地址>
MOCK_ORIGIN=

# 可选真实BFF：复制本文件为.env.live，填写实际环境，然后运行 pnpm live。
# 前端另用.env.local设置 VITE_API_BASE=http://127.0.0.1:5281，启动/构建前生效。
MEMOS_API_BASE_URL=http://127.0.0.1:8000
MEMOS_SERVICE_URL=http://127.0.0.1:8003
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5281
DASHBOARD_ORIGINS=http://127.0.0.1:5274,http://localhost:5274,http://127.0.0.1:5275,http://localhost:5275
DASHBOARD_DATA_DIR=.data/live
MEMOS_TIMEOUT_MS=10000
# 必须是已注册、激活且有创建cube权限的上游普通用户；不凭ID存在假设有权限。
MEMOS_CUBE_OWNER=
# 初始映射仅首次启动写入projects.json。请使用真实、已授权的user/cube/tenant。
DASHBOARD_WORKSPACES=[]
# 原生网关calls-*.jsonl所在目录；不可读取时日志/用量报错，不伪造为零。
MEMORY_CALL_LOG_DIR=
# 可选：与网关共享的gateway.env路径。共享整个父目录，BFF需要写权限。
DASHBOARD_GATEWAY_ENV=
# 服务端私有扩展token：自行生成至少32字符，BFF与MemOS配置一致，禁止VITE_前缀。
DASHBOARD_MEMORY_TOKEN=
DASHBOARD_PROMPT_TOKEN=
